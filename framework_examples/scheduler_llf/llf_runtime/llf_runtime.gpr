with "gtkada";

project llf_runtime extends "kernelWithParsers.gpr" is 
	PROJECT_DIR := external("CHEDDAR_DIR") & "/src/";
	for Source_Dirs use (PROJECT_DIR & "framework_examples/cache_analysis/util",
						PROJECT_DIR & "framework_examples/scheduler_llf/llf_runtime");
	for Main use ("llf_runtime_driver.adb");
	for Object_Dir use PROJECT_DIR & "binaries/objects/debug";
	for Exec_Dir use PROJECT_DIR & "framework_examples/scheduler_llf/llf_runtime";
end llf_runtime;



