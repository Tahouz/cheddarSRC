with "gtkada";

project scheduling_error_example extends "../../../gpr/kernelWithParsers.gpr" is 
	PROJECT_DIR := external("CHEDDAR_DIR") & "/src/";
	for Source_Dirs use (PROJECT_DIR & "framework_examples/scheduling_errors/ex1_scheduling_error_example");
	for Main use ("scheduling_error_example_driver.adb");
	for Object_Dir use PROJECT_DIR & "binaries/objects/debug";
	for Exec_Dir use PROJECT_DIR & "framework_examples/scheduling_errors/ex1_scheduling_error_example";
end scheduling_error_example;



