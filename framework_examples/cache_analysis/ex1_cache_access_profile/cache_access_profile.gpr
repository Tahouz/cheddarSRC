with "gtkada";

project cache_access_profile extends "../../../gpr/kernelWithParsers.gpr" is 
	PROJECT_DIR := external("CHEDDAR_DIR") & "/src/";
	for Source_Dirs use (PROJECT_DIR & "framework_examples/cache_analysis/util",
			     PROJECT_DIR & "framework_examples/cache_analysis/ex1_cache_access_profile");
	for Main use ("cache_access_profile_driver.adb");
	for Object_Dir use PROJECT_DIR & "binaries/objects/debug";
	for Exec_Dir use PROJECT_DIR & "framework_examples/cache_analysis/ex1_cache_access_profile";
end cache_access_profile;



