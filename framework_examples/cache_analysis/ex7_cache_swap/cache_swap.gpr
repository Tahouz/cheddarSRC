with "gtkada";

project cache_swap extends "kernelWithParsers.gpr" is 
	PROJECT_DIR := external("CHEDDAR_DIR") & "/src/";
	for Source_Dirs use (PROJECT_DIR & "framework_examples/cache_analysis/util",
						PROJECT_DIR & "framework_examples/cache_analysis/ex7_cache_swap");
	for Main use ("cache_swap_driver.adb");
	for Object_Dir use PROJECT_DIR & "binaries/objects/debug";
	for Exec_Dir use PROJECT_DIR & "framework_examples/cache_analysis/ex7_cache_swap";
end cache_swap;



