with "gtkada";

project test_add_execution_unit extends "../../../gpr/kernelWithParsers.gpr" is 
	PROJECT_DIR := external("CHEDDAR_DIR") & "/src/";
	for Source_Dirs use (PROJECT_DIR & "framework_examples/execution_units/ex1_test_add_execution_unit");
	for Main use ("test_add_execution_unit_driver.adb");
	for Object_Dir use PROJECT_DIR & "binaries/objects/debug";
	for Exec_Dir use PROJECT_DIR & "framework_examples/execution_units/ex1_test_add_execution_unit";
end test_add_execution_unit;



