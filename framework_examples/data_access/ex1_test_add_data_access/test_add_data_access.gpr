with "gtkada";

project test_add_data_access extends "../../../gpr/kernelWithParsers.gpr" is 
	PROJECT_DIR := external("CHEDDAR_DIR") & "/src/";
	for Source_Dirs use (PROJECT_DIR & "framework_examples/data_access/ex1_test_add_data_access");
	for Main use ("test_add_data_access_driver.adb");
	for Object_Dir use PROJECT_DIR & "binaries/objects/debug";
	for Exec_Dir use PROJECT_DIR & "framework_examples/data_access/ex1_test_add_data_access_unit";
end test_add_data_access;



