with Ada.Strings.Unbounded; use Ada.Strings.Unbounded;
with Framework_Config;      use Framework_Config;
with systems;               use systems;

package body cache_system_analysis is

   function compute_resource_cache_position
     (a_resource : in generic_resource_ptr;
      a_cache    : in generic_cache_ptr) return Natural
   is
   begin
      return compute_resource_cache_position (a_resource.all, a_cache.all);
   end compute_resource_cache_position;

   function compute_resource_cache_position
     (a_resource : in generic_resource'class;
      a_cache    : in generic_cache'class) return Natural
   is
   begin
      return (a_resource.address / a_cache.cache_size mod a_cache.line_size);
   end compute_resource_cache_position;

end cache_system_analysis;
