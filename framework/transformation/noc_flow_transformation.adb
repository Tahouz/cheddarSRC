           A_message1 := Search_Message (Output_Sys_WCCT.messages, Suppress_Space (To_Unbounded_String ("Message_of_flow" & i'Img & "from_source"))) ;
 	   A_task1    :=  Search_Task (Output_Sys_WCCT.Tasks, Suppress_Space (To_Unbounded_String ("Task_flow"&i'Img))) ;
  

           Add_One_Task_Dependency_asynchronous_communication (My_Dependencies => My_Dependencies,
