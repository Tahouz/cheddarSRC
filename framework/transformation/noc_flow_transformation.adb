	put_line ("from   :    "& To_String(A_task2.name) & "  to  " & To_String(A_taskND.name) & " over " & To_String(A_message1.name) ) ;



        i := i +1 ;
     
        exit when is_last_element (My_messages, My_Iterator2 );

