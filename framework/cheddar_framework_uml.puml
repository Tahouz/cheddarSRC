' ============================================================
' KEY COMPOSITION/ASSOCIATION RELATIONSHIPS
' ============================================================

' System aggregates all domain collections
system *-- "0..*" Generic_Task : contains
system *-- "0..*" Generic_Processor : contains
system *-- "0..*" Generic_Resource : contains
system *-- "0..*" Generic_Network : contains
system *-- "0..*" Generic_Memory : contains
system *-- "0..*" Generic_Message : contains

' Scheduler uses tasks and processors
generic_scheduler o-- Generic_Task : schedules
generic_scheduler o-- Generic_Processor : runs_on

' TCB references a task
tcb --> Generic_Task : references

' PCB references a scheduler
pcb --> generic_scheduler : uses

' DP Graph relates domain objects
Task_Node --> Generic_Task : models
Resource_Edge --> Generic_Resource : involves
Communication_Edge --> Generic_Message : involves
Buffer_Edge --> Buffer : involves

' Cache system relates to processors
Cache_System --> Generic_Cache : contains
Generic_Cache --> Cache_Block : contains

' Processor contains cores
Multi_Cores_Processor *-- "1..*" Core_Unit : contains

' Facade accesses framework components
Framework --> system : analyzes
Call_Scheduling_Framework --> generic_scheduler : configures
Call_Framework ..> Framework : invokes

' Parser produces system model
xml_generic_parser --> system : parses_into

' Feasibility tests depend on tasks and scheduler
Feasibility_Test ..> Generic_Task : tests
Feasibility_Test ..> generic_scheduler : uses

' PAES optimizes system
generic_solution --> system : optimizes

' Priority assignment
Priority_Assignment ..> Generic_Task : assigns_to

@enduml