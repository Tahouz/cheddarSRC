	if (obj /= NULL) then
		put("type_of_PortMappingType_Choice: "); put(obj.type_of_PortMappingType_Choice); put ( "; " );
		put ( "value: " );
		case obj.type_of_PortMappingType_Choice is 
			when pseudo_partition_Choice => 
