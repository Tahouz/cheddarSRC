		bus_connected : requires bus access ;
end cpu2;

processor implementation cpu2.Impl
	properties 
		Scheduling_Protocol => POSIX_1003_HIGHEST_PRIORITY_FIRST_PROTOCOL;
		Cheddar_Properties::Scheduler_Quantum =>  0 ms ;
		Cheddar_Properties::Preemptive_Scheduler => False;
end cpu2.Impl;


system Cheddar
end Cheddar;

system implementation Cheddar.Impl
	subcomponents
		instancied_cpu2 : processor cpu2.Impl;
		instancied_addr3 : process addr3.Impl;
	properties
		Actual_Processor_Binding => reference instancied_cpu2 applies to instancied_addr3;
end Cheddar.Impl;



